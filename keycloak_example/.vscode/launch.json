{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [        
        {
            "name": "Launch Simple Webapp",
            "type": "node",
            "program": "server.js",
            "cwd": "${workspaceFolder}/simple/webapp",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["start", "debug"],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Launch Simple Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd":"${workspaceFolder}/simple/server",
            "args": [
                "main:app",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "User Manager Launch Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd":"${workspaceFolder}/userman/backend",
            "args": [
                "main:app",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "User Manager Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}/userman/frontend"
        }
    ]
}